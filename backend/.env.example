# Local backend. Load with Node 24: node --env-file=.env server.js
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Required: supply a fresh random secret, at least 32 UTF-8 bytes. No fallback is accepted.
JWT_SECRET=
# Optional persistent locations; relative values are resolved from the process working directory.
DB_PATH=
UPLOADS_DIR=
# Optional comma-separated browser origins. Empty rejects cross-origin browser access.
CORS_ORIGINS=
